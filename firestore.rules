rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isTeacher() {
      return isSignedIn() && userDoc(request.auth.uid).data.role == 'teacher';
    }

    function isStudent() {
      return isSignedIn() && userDoc(request.auth.uid).data.role == 'student';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isTeacher());
      allow create: if isTeacher();
      allow update: if isTeacher() || request.auth.uid == userId;
      allow delete: if isTeacher();
    }

    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacher();
    }

    match /attendance/{attendanceId} {
      allow create, update, delete: if isTeacher();
      allow read: if isTeacher() || (isStudent() && resource.data.studentId == request.auth.uid);
    }

    match /points/{pointId} {
      allow create, update, delete: if isTeacher();
      allow read: if isTeacher() || (isStudent() && resource.data.studentId == request.auth.uid);
    }

    match /lectures/{lectureId} {
      allow create, update, delete: if isTeacher();
      allow read: if isSignedIn();
    }

    match /notifications/{notificationId} {
      allow create, update, delete: if isTeacher();
      allow read: if isSignedIn();
    }

    match /notification_queue/{docId} {
      allow create: if isTeacher();
      allow read, update, delete: if false;
    }
  }
}
